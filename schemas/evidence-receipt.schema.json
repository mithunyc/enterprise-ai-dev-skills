{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceReceipt",
  "description": "Validates the YAML frontmatter of templates/evidence-receipt.md",
  "type": "object",
  "required": ["type", "gate_results_ref", "gate_status", "confidence", "status"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["evidence-receipt"],
      "description": "Must be 'evidence-receipt'"
    },
    "gate_results_ref": {
      "type": "string",
      "description": "Relative path to gate-results.json — e.g. '.buildloop-runs/<run_id>/gate-results.json'"
    },
    "gate_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PARTIAL", "NOT_RUN"],
      "description": "Overall result from the gate-runner run"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "Agent's confidence in the receipt claims"
    },
    "status": {
      "type": "string",
      "enum": ["GO", "CONDITIONAL_GO", "NO_GO"],
      "description": "Recommendation for human approval"
    }
  },
  "additionalProperties": false
}
